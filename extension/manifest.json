{
  "manifest_version": 3,
  "name": "AIUB Smart Slide Downloader",
  "version": "11.1",
  "description": "Downloads only new or missing slides/notes from the AIUB portal and your Microsoft Teams classes into Desktop/AIUB/<Course>/, numbered in course order, without duplicates. Asks before installing a new version.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "downloads",
    "scripting",
    "activeTab",
    "nativeMessaging",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://portal.aiub.edu/*",
    "https://aiubedu60714.sharepoint.com/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/*",
    "https://codeload.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.aiub.edu/Student*"
      ],
      "js": [
        "lib.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://aiubedu60714.sharepoint.com/sites/msteams_*"
      ],
      "js": [
        "site-learner.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AIUB Smart Slide Downloader - check for new files now",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "key": ""
}
