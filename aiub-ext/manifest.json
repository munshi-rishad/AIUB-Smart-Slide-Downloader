{
  "manifest_version": 3,
  "name": "AIUB Course Material Downloader",
  "version": "6.0",
  "description": "Auto-checks your active AIUB courses' Notes after login and saves only new/missing files into Desktop/AIUB/<Course>/ (needs the small AIUB helper installed once).",
  "permissions": [
    "downloads",
    "scripting",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://portal.aiub.edu/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.aiub.edu/Student*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AIUB Downloader - check for new files now"
  },
  "key": ""
}